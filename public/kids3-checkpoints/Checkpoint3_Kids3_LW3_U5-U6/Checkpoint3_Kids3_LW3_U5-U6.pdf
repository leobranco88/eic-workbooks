     <rdf:li>Zurich, Day Gecko, Color Image, Horizontal, Zoo, Photography, Vibrant Color, Rainforest, Animal Wildlife, No People, Green Color,</rdf:li>
     <rdf:li/>
     <rdf:li/>
    </rdf:Bag>
   </dc:subject>
