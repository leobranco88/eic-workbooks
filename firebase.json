{
  "hosting": [
    {
      "target": "worksheets",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        }
      ],
      "predeploy": [
        "node generate-hub.cjs"
      ]
    },
    {
      "target": "familia",
      "public": "public-familia",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        }
      ],
      "predeploy": [
        "node generate-hub.cjs"
      ]
    }
  ]
}
